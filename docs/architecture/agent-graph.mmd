---
config:
  flowchart:
    curve: linear
---
graph TD;
    __start__([__start__]):::first
    decompose(decompose)
    retrieve_one(retrieve_one)
    grade(grade)
    refine(refine)
    synthesize(synthesize)
    finalize(finalize)
    prepare_multi(prepare_multi)
    retrieval_worker(retrieval_worker)
    fan_in(fan_in)
    __end__([__end__]):::last
    __start__ --> decompose;
    decompose -. retrieve_multi .-> prepare_multi;
    decompose -.-> retrieve_one;
    fan_in --> grade;
    grade -.-> refine;
    grade -. abstain_or_synthesize .-> synthesize;
    prepare_multi -.-> grade;
    prepare_multi -.-> retrieval_worker;
    refine --> prepare_multi;
    retrieval_worker --> fan_in;
    retrieve_one --> grade;
    synthesize --> finalize;
    finalize --> __end__;
    classDef default fill:#f2f0ff
    classDef first fill:#ffffff,stroke:#999999,color:#333333
    classDef last fill:#bfb6fc

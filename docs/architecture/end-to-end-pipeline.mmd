%% PrismRAG 端到端闭环（入库 → 视觉显存 → 三路检索精排 → 生成/拒答 → 三层评测回灌）
%% 对齐：ingestion / content-pipeline / visual MaxSim / retrieval / evaluation
%% 主表：ViDoRe v3 Industrial 283q en · Full_zerank2 NDCG@10 = 0.5454
%% 渲染：VS Code Mermaid / https://mermaid.live
flowchart TB
  PDF(["工业 PDF / ViDoRe 页语料"]) --> PARSE

  subgraph ING["② 增量入库管线"]
    direction TB
    PARSE["MinerU 解析<br/>markdown + 整页截图"]
    PARSE --> HASH{"content_hash / doc_id<br/>+ page_hash"}
    HASH -->|同内容| NOOP["noop 不写库"]
    HASH -->|新文档| FRESH["全页编码写入"]
    HASH -->|同 doc 改页| DIFF["只重编码变更页<br/>未变页跳过 ColQwen2"]
    FRESH --> CHUNK
    DIFF --> CHUNK

    subgraph TXT["文本侧 · chunk"]
      direction TB
      CHUNK["清洗 + 分块 ~512 token"]
      CHUNK --> TBL{"是否表格?"}
      TBL -->|是| TS["同页表块拼回<br/>按行切并复制表头<br/>LLM 1–3 句表摘要"]
      TBL -->|否| TX["普通文本 chunk"]
      TS --> BGE["Dense：表摘要走 BGE<br/>BM25/生成：完整 markdown"]
      TX --> BGE
    end

    subgraph VISENC["视觉侧 · page"]
      VENC["ColQwen2 整页多向量编码<br/>~patches/page → 128d"]
    end

    BGE --> PG[("pgvector<br/>chunk + BGE 向量 + table_summary")]
    BGE --> BM[("BM25 倒排<br/>增量 fit / remove")]
    VENC --> FA[("FAISS 多向量<br/>page 级 · MaxSim")]
    CHUNK --> VENC
  end

  PG --> IDX
  BM --> IDX
  FA --> IDX
  IDX["三路共享 doc_id / page_id<br/>index_version++ · invalidate_cache"]
  IDX --> Q

  Q(["用户问句 / 评测 query ×283"]) --> PRE
  Q --> Q2

  subgraph VRAM["④ Visual MaxSim 显存治理 · 评测/批量查询"]
    direction TB
    PRE["Phase A · query 预编码<br/>encode_queries_batch 283 条"]
    PRE --> UL["unload ColQwen2<br/>empty_cache · 模型与索引不同时占 GPU"]
    UL --> LOAD["Phase B · FAISS 向量上 GPU<br/>~2.6GB patches"]
    LOAD --> MS{"MaxSim 怎么乘?"}
    MS -->|禁止| OOM["全量 q@Vᵀ<br/>1032 × 5.38M × 4B ≈ 21GB → OOM"]
    MS -->|采用| BAT["按页分批 PAGE_BATCH=200<br/>中间矩阵 ~800MB / batch"]
    BAT --> PAGES["页级 MaxSim 分数 Top-k pages"]
  end

  subgraph RET["① 多模态混合检索与精排"]
    direction TB
    Q2["同一 query 三路并行"] --> BM25["BM25 精确词"]
    Q2 --> DEN["Dense / BGE 语义"]
    PAGES --> GND["视觉命中按页 grounding<br/>page_id → pg 回查该页 text/table chunk"]
    BM25 --> RRF
    DEN --> RRF
    GND --> RRF
    RRF["RRF 融合<br/>Full_no_rerank = 0.483"]
    RRF --> RR["zerank-2 精排<br/>Full_zerank2 = 0.545  ·  +0.06"]
  end

  RR --> CTX

  subgraph GEN["生成 / 拒答"]
    direction TB
    CTX["soft_rank 压入模噪音<br/>表 chunk 不做句级硬删"]
    CTX --> GATE{"证据是否足够?"}
    GATE -->|否| REJ["统一拒答<br/>不进 Faith/Rel 均值"]
    GATE -->|是| ANS["带页引用生成答案"]
  end

  ANS --> L1
  REJ --> L3

  subgraph EVAL["③ 三层评测归因"]
    direction TB
    L1["L1 检索 · NDCG@10 消融 283q<br/>BM25 / Dense / Visual / 融合 / 精排"]
    L1 --> L2["L2 生成 · RAGAS<br/>Faithfulness · Answer Rel · CtxRel"]
    L2 --> L3["L3 端到端 · 50 可答 + 20 应拒<br/>Correct · RejectAcc"]
    L3 --> ATTR{"失败落在哪一层?"}
    ATTR -->|排序/漏召| F1["检索错 → 改融合 / 精排 / 切块 / Visual"]
    ATTR -->|上下文不支持| F2["幻觉 → 改压缩 / 拒答 / 生成约束"]
    ATTR -->|可答却拒| F3["误拒 → 改证据门限 / 召回"]
  end

  F1 -.->|"迭代入库或检索"| CHUNK
  F1 -.->|"迭代视觉路"| BAT
  F1 -.->|"迭代精排"| RR
  F2 -.->|"迭代生成"| CTX
  F3 -.->|"迭代拒答"| GATE

  classDef ingest fill:#e8f1ff,stroke:#3b6ea5,color:#123
  classDef visual fill:#fff3e0,stroke:#c47b17,color:#123
  classDef retr fill:#e8f7ee,stroke:#2e7d4f,color:#123
  classDef evalc fill:#f3e8ff,stroke:#6b3fa0,color:#123
  classDef store fill:#f7f7f7,stroke:#666,color:#123
  classDef danger fill:#fdecea,stroke:#b42318,color:#123
  classDef ok fill:#eaf7ea,stroke:#1b7f3b,color:#123

  class PARSE,HASH,FRESH,DIFF,CHUNK,TBL,TS,TX,BGE,VENC ingest
  class PRE,UL,LOAD,MS,BAT,PAGES visual
  class Q2,BM25,DEN,GND,RRF,RR retr
  class L1,L2,L3,ATTR,F1,F2,F3 evalc
  class PG,BM,FA,IDX store
  class OOM danger
  class NOOP,ANS,REJ ok
